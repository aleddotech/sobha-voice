# LiveKit Cloud (required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_WRAPUP_MODEL=gpt-4.1-mini
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Female Indian voice (Riya Rao) for Arabic only. English/Hindi/Malayalam use Sarvam.
ELEVEN_VOICE_ID=hLvRzHEBXR9scnhmrX9E
ELEVEN_MODEL_ID=eleven_multilingual_v2

# Optional
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=

# Local web server (Render sets PORT automatically)
PORT=8765

# 1 = spawn LiveKit worker from FastAPI (local / single-process).
# Set 0 on Render web when the separate worker service is running.
SPAWN_AGENT=1

# Comma-separated origins for the Vercel playground (token API CORS)
CORS_ORIGINS=http://localhost:8765,http://localhost:3000,https://sobha-voice.vercel.app

# Call log (Render worker posts transcripts here)
CALLS_API_URL=http://localhost:8765
PUBLIC_BASE_URL=http://localhost:8765
