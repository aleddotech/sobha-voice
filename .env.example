# LiveKit Cloud (required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech / LLM
OPENAI_API_KEY=
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=i80JxxvpWr5Q7cTdT1Ik
ELEVEN_MODEL_ID=eleven_multilingual_v2

# Optional
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=

# Local web server (Render sets PORT automatically)
PORT=8765

# 1 = spawn LiveKit worker from FastAPI (local / single-process).
# Set 0 on Render web when the separate worker service is running.
SPAWN_AGENT=1

# Comma-separated origins for the Vercel playground (token API CORS)
CORS_ORIGINS=http://localhost:8765,http://localhost:3000
